{
  "version": 1,
  "tile_size": 32,
  "coordinate_space": {
    "origin": "party_center",
    "axes": {
      "forward": "unit facing direction (leader points this way)",
      "right": "perpendicular to facing, right-hand side",
      "note": "Program should rotate these offsets by facing angle. Example screen deltas below assume facing South (forward = +Y on screen, right = -X)."
    }
  },
  "rules": {
    "order_front_to_back": [
      "leader",
      "deputies",
      "soldiers"
    ],
    "max_hero_slots": 3,
    "hero_slots": [
      "leader",
      "deputy_0",
      "deputy_1"
    ],
    "heroes_not_in_tier_fusion": true,
    "hero_comment": "武将单独精灵，不进 T0–T3 士兵合成；仅士兵做升阶合成",
    "soldier_visible_budget": {
      "suggested_max_sprites": 8,
      "comment": "同屏可读上限建议；具体兵数公式由策划定，此处只给锚点"
    }
  },
