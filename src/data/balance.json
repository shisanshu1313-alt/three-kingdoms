    "speed_penalty_per_soldier": 0.0005,
    "speed_min_mult": 0.6,
    "speed_formula": "speed = speed_base × max(speed_min_mult, 1 − speed_penalty_per_soldier × N) × (1 + Σ物品speed_pct) × 地形倍率 × 状态倍率（战败脱离期 escape_speed_mult，否则 1）；只有兵数项有 0.6 下限，乘完不再整体截断；AI 同一公式"
  },
  "power": {
    "formula": "P = N * (1 + k_lead*主将统率 + k_str*Σ武力 + 物品战力%) + k_gen*Σ武力",
    "k_lead": 0.005,
    "k_str": 0.002,
    "k_gen": 0.5,
    "k_int_loss_reduction": 0.003,
    "int_loss_reduction_cap": 0.3,
    "loss_reduction_total_cap": 0.5,
    "loss_reduction_formula": "减免 = clamp(min(int_loss_reduction_cap, k_int × 队内最高智力) + Σ物品loss_reduction, 0, loss_reduction_total_cap)；智力部分范围 0~0.30，兵书在其上另加，总和封顶 0.50"
  },
  "battle": {
    "random_min": 0.9,
    "random_max": 1.1,
    "draw_ratio": 1.05,
    "winner_loss_base": 0.25,
    "winner_loss_exp": 1.5,
    "loser_loss_base": 0.3,
    "loser_loss_per_ratio": 0.2,
    "loser_loss_max": 0.8,
    "draw_loss": 0.2,
    "draw_pushback_px": 80,
    "draw_pair_cooldown_s": 5,
    "duration_base_s": 1.5,
    "duration_k_s": 6,
    "duration_min_s": 2,
    "duration_max_s": 8,
    "lock_third_party": true,
    "player_defeat": {
      "keep_survivor_ratio": 0.5,
      "hero_never_captured": true,
      "invincible_s": 8,
      "escape_speed_mult": 1.3,
      "min_soldiers": 5,
      "kept_formula": "kept = max(min_soldiers, floor(溃兵 × keep_survivor_ratio))；剩余溃兵 = max(0, 溃兵 − kept) 供 AI 胜方收编"
    },
    "random_rule": "碰撞瞬间每方独立掷一次均匀分布 U(random_min, random_max)，乘到各自面板战力；用可复现 rng；本场只掷这一次",
    "ratio_rule": "R = max(Pa',Pb') / min(Pa',Pb')，Pa'/Pb' 为乘随机后的战力；R < draw_ratio 为平局（含完全相等），否则 rolled 战力高者胜",
    "loss_formula": {
      "winner": "round(N_w × winner_loss_base × (1/R)^winner_loss_exp × (1 − 减免_w))",
      "loser_dead": "round(N_l × min(loser_loss_max, loser_loss_base + loser_loss_per_ratio × (R − 1)) × (1 − 减免_l))",
      "draw": "round(N × draw_loss × (1 − 减免))，双方各自计算",
      "rounding": "Math.round（.5 进位），结果再 clamp 到 [0, N]",
      "loser_survivors": "N_l − loser_dead（溃兵）"
    },
    "duration_formula": "T = clamp(duration_base_s + duration_k_s / R, duration_min_s, duration_max_s)，R 用乘随机后的比值；平局同一公式",
    "during_battle": "T 秒内双方停止移动，不触发任何碰撞，AI 不把它们当目标；损兵数字线性播放，T 结束时一次性写入全部结果",
    "post_battle_grace_s": 1,
    "ai_loser": "disband：AI 败方整队移除；溃兵中未被收编的消失；物品消失；未被俘的名将回自由池，未被俘的黄巾头目消失"
  },
  "rewards": {
    "points_base": 5,
    "points_per_enemy_power": 0.3,
    "bully_ratio": 4,
    "bully_mult": 0.5,
    "recruit_base": 0.2,
    "recruit_per_cha": 0.004,
