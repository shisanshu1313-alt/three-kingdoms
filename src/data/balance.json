    "capture_min": 0.05,
    "capture_max": 0.8,
    "release_captive_points": 20,
    "ai_also_recruits": true,
    "points_formula": "round((points_base + points_per_enemy_power × 败方面板战力) × (R ≥ bully_ratio ? bully_mult : 1))；败方面板战力 = 战前、不乘随机；R 用乘随机后的比值；只有玩家胜利得分，平局/战败/AI 间战斗 0 分",
    "recruit_formula": "收编 = floor(基数 × min(recruit_max, recruit_base + recruit_per_cha × 胜方队内最高魅力 + Σ物品recruit_pct))；基数 = 败方溃兵（玩家战败时为保留后的剩余溃兵）；胜方结算后兵数 = min(兵力上限, N_w − 胜方损兵 + 收编)",
    "capture_formula": "败方每名武将单独掷：p = clamp(capture_base + capture_per_cha_diff × (胜方最高魅力 − 该武将魅力) + capture_per_ratio × (R − 1), capture_min, capture_max)",
    "capture_rules": {
      "hero_never_captured": true,
      "ai_captures_generals": true,
      "ai_full_team": "AI 胜方已有 3 名武将时，被俘武将改回自由池",
